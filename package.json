{
  "name": "ferdy-platter",
  "version": "0.1.6",
  "private": true,
  "description": "Web OS Monorepo built with SolidJS, Vite, and TypeScript (Single-Server MPA Mode)",
  "workspaces": [
    "packages/assets",
    "packages/base/*",
    "packages/core",
    "packages/domains/**",
    "packages/etc/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ferdy/core",
    "build": "npm run build --workspace=@ferdy/core",
    "preview": "npm run preview --workspace=@ferdy/core",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
